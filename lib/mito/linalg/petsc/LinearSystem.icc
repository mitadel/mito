// get the solution at entry {row}
template <class solutionT>
auto
mito::linalg::petsc::LinearSystem::read_solution(solutionT & solution) const -> void
{
    // get the solution vector
    _solution.get_vector(solution);

    // all done
    return;
}


#endif    // mito_linalg_backend_petsc_LinearSystem_icc

