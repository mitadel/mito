#if !defined(mito_linalg_backend_petsc_Vector_icc)
#error This header file contains implementation details of class mito::linalg::petsc::Vector
#else


// add a linear combination: this <- this + sum_i alphas[i] * vectors[i]
template <std::ranges::input_range vectorsT>
auto
mito::linalg::petsc::Vector::add(std::span<const scalar_type> alphas, const vectorsT & vectors)
    -> void
{
    // one coefficient per vector
    if (std::size(alphas) != std::size(vectors)) {
        journal::error_t channel("mito.linalg.petsc.Vector.add");
        channel << std::size(alphas) << " coefficients but " << std::size(vectors) << " vectors"
                << journal::endl;
        return;
    }

    // collect the PETSc handles
    std::vector<Vec> handles;
    handles.reserve(std::size(vectors));
    for (const auto * vector : vectors) {
        handles.push_back(vector->_vector);
    }

    // delegate to PETSc
    PetscCallVoid(VecMAXPY(
        _vector, static_cast<PetscInt>(std::size(handles)), alphas.data(), handles.data()));

    // all done
    return;
}

// get the vector at entry {row}
template <class vectorT>
auto
mito::linalg::petsc::Vector::get_vector(vectorT & vector) const -> void
{
    // get a pointer to the beginning of {_vector}
    const scalar_t * u;
    PetscCallVoid(VecGetArrayRead(_vector, &u));

    // get the size of the vector
    PetscInt vector_size = size();

    // check that the size of {_vector} matches the size of {vector}
    assert(vector_size == (int) std::size(vector));

    // copy {_vector} into {vector}
    std::copy(u, u + vector_size, std::begin(vector));

    // restore the array after reading
    PetscCallVoid(VecRestoreArrayRead(_vector, &u));

    // all done
    return;
}


#endif    // mito_linalg_backend_petsc_Vector_icc

// end of file
